PORT=5000
NODE_ENV=development
# Production: comma-separated browser origins, without Markdown brackets or links.
FRONTEND_URLS=https://devdarshanlive.com,https://www.devdarshanlive.com,https://api.devdarshanlive.com

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=live_darshan_db

# Security
JWT_SECRET=replace_with_a_long_random_jwt_secret

# Razorpay Configuration
# Replace these with your live Razorpay keys when going live
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_SECRET=rzp_live_your_secret_here
RAZORPAY_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
