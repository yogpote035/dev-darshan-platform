<%- include('../partials/header', { title: 'Notifications - Dev Darshan Live' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <!-- Content Header -->
  <div class="content-header">
    <div class="content-title">
      <h2>Announcements & Push Notifications</h2>
      <p>Send instant announcements, festive messages, or stream updates to all active mobile users.</p>
    </div>
    <div>
      <a href="/admin/notifications/add" class="btn btn-gold-admin">
        <i class="fa-solid fa-paper-plane me-2"></i>Compose Message
      </a>
    </div>
  </div>

  <!-- Alerts -->
  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Notifications List -->
  <div class="table-dark-custom">
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle m-0">
        <thead>
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Message Body</th>
            <th>Sent At</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (notifications && notifications.length > 0) { %>
            <% notifications.forEach(item => { %>
              <tr>
                <td>
                  <% if (item.image) { %>
                    <img src="<%= item.image %>" alt="<%= item.title %>" class="rounded border border-secondary" style="width: 50px; height: 50px; object-fit: cover;">
                  <% } else { %>
                    <div class="bg-secondary rounded border border-secondary d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px; font-size: 0.7rem;">
                      No Image
                    </div>
                  <% } %>
                </td>
                <td class="fw-semibold"><%= item.title %></td>
                <td>
                  <div class="pe-3" style="max-width: 500px; font-size: 0.9rem; line-height: 1.4;"><%= item.message %></div>
                </td>
                <td>
                  <% const created = new Date(item.created_at); %>
                  <span class="notification-date"><%= created.toLocaleDateString('en-IN') %></span>
                  <small class="notification-time"><%= created.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></small>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex">
                    <a href="/admin/notifications/<%= item.id %>/delete" class="btn-action btn-delete" title="Delete Notification" onclick="return confirm('Are you sure you want to delete this notification? It will be deleted from all user inboxes.')">
                      <i class="fa-solid fa-trash-can"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-5 text-muted">
                <i class="fa-solid fa-bullhorn fs-2 mb-3 d-block"></i>
                No notifications dispatched yet. Click "Compose Message" to send one.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
