<%- include('../partials/header', { title: 'Withdrawal Requests - Dev Darshan Live' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <!-- Content Header -->
  <div class="content-header">
    <div class="content-title">
      <h2>Withdrawal Requests</h2>
      <p>Manage and process user earnings withdrawal requests manually via UPI QR or Bank Transfers.</p>
    </div>
  </div>

  <!-- Alerts -->
  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Withdrawals Table -->
  <div class="table-dark-custom">
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle m-0">
        <thead>
          <tr>
            <th>User</th>
            <th>Amount</th>
            <th>Method</th>
            <th>Payment details</th>
            <th>Status</th>
            <th>Admin Notes / Reason</th>
            <th>Requested At</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (withdrawals && withdrawals.length > 0) { %>
            <% withdrawals.forEach(req => { %>
              <tr>
                <td>
                  <% if (req.User) { %>
                    <span class="fw-semibold"><%= req.User.full_name %></span> <br/>
                    <small class="text-muted"><%= req.User.phone %></small>
                  <% } else { %>
                    <span class="text-danger">Unknown (ID: <%= req.user_id %>)</span>
                  <% } %>
                </td>
                <td>
                  <span class="fw-bold text-warning" style="font-size: 15px;">₹<%= parseFloat(req.amount).toFixed(2) %></span>
                </td>
                <td>
                  <% if (req.payment_method === 'qr_code') { %>
                    <span class="badge bg-info"><i class="fa-solid fa-qrcode me-1"></i>UPI QR Code</span>
                  <% } else { %>
                    <span class="badge bg-primary"><i class="fa-solid fa-building-columns me-1"></i>Bank Transfer</span>
                  <% } %>
                </td>
                <td>
                  <% if (req.payment_method === 'qr_code') { %>
                    <% if (req.qr_code_image) { %>
                      <a href="<%= req.qr_code_image %>" target="_blank" class="btn btn-sm btn-outline-warning">
                        <i class="fa-solid fa-eye me-1"></i>View UPI QR
                      </a>
                    <% } else { %>
                      <span class="text-muted">No QR image</span>
                    <% } %>
                  <% } else { %>
                    <div style="font-size: 12px; line-height: 1.4;">
                      <strong>Holder:</strong> <%= req.account_holder_name %> <br/>
                      <strong>Bank:</strong> <%= req.bank_name %> <br/>
                      <strong>A/C:</strong> <code><%= req.account_number %></code> <br/>
                      <strong>IFSC:</strong> <code><%= req.ifsc_code %></code>
                    </div>
                  <% } %>
                </td>
                <td>
                  <span class="badge-status <%= req.status === 'approved' ? 'active' : (req.status === 'rejected' ? 'blocked' : 'pending') %>">
                    <%= req.status.toUpperCase() %>
                  </span>
                </td>
                <td>
                  <% if (req.admin_notes) { %>
                    <span class="text-light" style="font-size: 13px;"><%= req.admin_notes %></span>
                  <% } else { %>
                    <span class="text-muted" style="font-style: italic;">None</span>
                  <% } %>
                </td>
                <td>
                  <% const date = new Date(req.created_at); %>
                  <span class="withdrawal-request-date"><%= date.toLocaleDateString('en-IN') %></span>
                  <small class="withdrawal-request-time"><%= date.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></small>
                </td>
                <td class="text-end">
                  <% if (req.status === 'pending') { %>
                    <div class="d-inline-flex gap-2">
                      <button 
                        type="button" 
                        class="btn btn-sm btn-success px-3" 
                        data-bs-toggle="modal" 
                        data-bs-target="#approveModal<%= req.id %>"
                      >
                        <i class="fa-solid fa-check me-1"></i>Approve
                      </button>
                      <button 
                        type="button" 
                        class="btn btn-sm btn-danger px-3" 
                        data-bs-toggle="modal" 
                        data-bs-target="#rejectModal<%= req.id %>"
                      >
                        <i class="fa-solid fa-xmark me-1"></i>Reject
                      </button>
                    </div>

                    <!-- Approve Modal -->
                    <div class="modal fade" id="approveModal<%= req.id %>" tabindex="-1" aria-labelledby="approveModalLabel<%= req.id %>" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-light border-secondary">
                          <form action="/admin/withdrawals/<%= req.id %>/approve" method="POST">
                            <div class="modal-header border-secondary">
                              <h5 class="modal-title text-success" id="approveModalLabel<%= req.id %>">
                                <i class="fa-solid fa-circle-check me-2"></i>Approve Withdrawal Request
                              </h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                              <p>Are you sure you want to approve this withdrawal request of <strong class="text-warning">₹<%= parseFloat(req.amount).toFixed(2) %></strong> for <strong><%= req.User ? req.User.full_name : 'User' %></strong>?</p>
                              <p class="text-muted small">Please verify that you have manually completed the payout to their payment target before confirming.</p>
                              
                              <div class="mb-3">
                                <label for="approve_notes_<%= req.id %>" class="form-label">Payment Reference / Transaction ID (Optional)</label>
                                <input type="text" class="form-control bg-secondary text-light border-secondary" id="approve_notes_<%= req.id %>" name="admin_notes" placeholder="e.g. UPI Ref: 6812839217, IMPS Ref: 9812739">
                              </div>
                            </div>
                            <div class="modal-footer border-secondary">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-success">Confirm Approval</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                    <!-- Reject Modal -->
                    <div class="modal fade" id="rejectModal<%= req.id %>" tabindex="-1" aria-labelledby="rejectModalLabel<%= req.id %>" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-light border-secondary">
                          <form action="/admin/withdrawals/<%= req.id %>/reject" method="POST">
                            <div class="modal-header border-secondary">
                              <h5 class="modal-title text-danger" id="rejectModalLabel<%= req.id %>">
                                <i class="fa-solid fa-triangle-exclamation me-2"></i>Reject & Refund Withdrawal Request
                              </h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                              <p>Are you sure you want to reject this withdrawal request of <strong class="text-warning">₹<%= parseFloat(req.amount).toFixed(2) %></strong>?</p>
                              <p class="text-danger small"><i class="fa-solid fa-info me-1"></i>Confirming this will instantly refund ₹<%= parseFloat(req.amount).toFixed(2) %> back to the user's wallet balance.</p>
                              
                              <div class="mb-3">
                                <label for="reject_notes_<%= req.id %>" class="form-label">Reason for Rejection <span class="text-danger">*</span></label>
                                <textarea class="form-control bg-secondary text-light border-secondary" id="reject_notes_<%= req.id %>" name="admin_notes" rows="3" placeholder="e.g. Invalid bank credentials, QR code blur / inactive." required></textarea>
                              </div>
                            </div>
                            <div class="modal-footer border-secondary">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  <% } else { %>
                    <span class="withdrawal-no-actions">No actions</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="fa-solid fa-building-columns fs-2 mb-3 d-block"></i>
                No withdrawal requests found.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
