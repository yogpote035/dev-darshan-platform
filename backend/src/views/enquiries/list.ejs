<%- include('../partials/header', { title: 'Contact Enquiries - Dev Darshan Live' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <!-- Content Header -->
  <div class="content-header">
    <div class="content-title">
      <h2>Contact Enquiries & Support</h2>
      <p>View user questions, complaints, or feedback submitted via the React contact page.</p>
    </div>
  </div>

  <!-- Alerts -->
  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Enquiries Table -->
  <div class="table-dark-custom">
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle m-0">
        <thead>
          <tr>
            <th>User Name</th>
            <th>Phone Number</th>
            <th>Message Details</th>
            <th>Submitted At</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (enquiries && enquiries.length > 0) { %>
            <% enquiries.forEach(enquiry => { %>
              <tr>
                <td class="fw-semibold"><%= enquiry.name %></td>
                <td>
                  <a href="tel:<%= enquiry.phone %>" class="text-warning text-decoration-none">
                    <i class="fa-solid fa-phone me-1"></i><%= enquiry.phone %>
                  </a>
                </td>
                <td>
                  <div class="pe-3" style="max-width: 450px; font-size: 0.9rem; line-height: 1.4; white-space: pre-wrap;"><%= enquiry.message %></div>
                </td>
                <td>
                  <% const date = new Date(enquiry.created_at); %>
                  <span class="enquiry-date"><%= date.toLocaleDateString('en-IN') %></span>
                  <small class="enquiry-time"><%= date.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></small>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex">
                    <a href="/admin/enquiries/<%= enquiry.id %>/delete" class="btn-action btn-delete" title="Delete Enquiry" onclick="return confirm('Are you sure you want to delete this enquiry?')">
                      <i class="fa-solid fa-trash-can"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-5 text-muted">
                <i class="fa-solid fa-envelope-open fs-2 mb-3 d-block"></i>
                No enquiries found. All quiet!
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
