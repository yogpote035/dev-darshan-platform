<%- include('../partials/header', { title: 'Advertisements - Dev Darshan Live' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <!-- Content Header -->
  <div class="content-header">
    <div class="content-title">
      <h2>Advertisement Management</h2>
      <p>Configure advertisements, popup frequencies, and target links for free-tier users.</p>
    </div>
    <div>
      <a href="/admin/ads/add" class="btn btn-gold-admin">
        <i class="fa-solid fa-plus me-2"></i>Create Ad Banner
      </a>
    </div>
  </div>

  <!-- Alerts -->
  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Ads Table -->
  <div class="table-dark-custom">
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle m-0">
        <thead>
          <tr>
            <th>Ad Banner</th>
            <th>Title</th>
            <th>Trigger (Time)</th>
            <th>Trigger (Videos)</th>
            <th>Redirect Link</th>
            <th>Status</th>
            <th>Created At</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (ads && ads.length > 0) { %>
            <% ads.forEach(ad => { %>
              <tr>
                <td>
                  <% if (ad.image) { %>
                    <img src="<%= ad.image %>" alt="<%= ad.title %>" class="rounded border border-secondary" style="width: 80px; height: 50px; object-fit: cover;">
                  <% } else { %>
                    <div class="bg-secondary rounded border border-secondary d-flex align-items-center justify-content-center text-muted" style="width: 80px; height: 50px; font-size: 0.75rem;">
                      No Image
                    </div>
                  <% } %>
                </td>
                <td class="fw-semibold"><%= ad.title %></td>
                <td>After <%= ad.display_after_minutes %> mins</td>
                <td>After <%= ad.display_after_videos %> videos</td>
                <td>
                  <% if (ad.redirect_url) { %>
                    <a href="<%= ad.redirect_url %>" target="_blank" class="text-warning text-truncate d-inline-block" style="max-width: 150px;"><%= ad.redirect_url %></a>
                  <% } else { %>
                    <span class="text-muted">None</span>
                  <% } %>
                </td>
                <td>
                  <a href="/admin/ads/<%= ad.id %>/toggle" class="text-decoration-none">
                    <span class="badge-status <%= ad.status === 1 ? 'active' : 'inactive' %>">
                      <%= ad.status === 1 ? 'ACTIVE' : 'INACTIVE' %>
                    </span>
                  </a>
                </td>
                <td>
                  <% const created = new Date(ad.created_at); %>
                  <%= created.toLocaleDateString('en-IN') %>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex">
                    <a href="/admin/ads/<%= ad.id %>/edit" class="btn-action btn-edit" title="Edit Ad">
                      <i class="fa-solid fa-pen-to-square text-warning"></i>
                    </a>
                    <a href="/admin/ads/<%= ad.id %>/delete" class="btn-action btn-delete" title="Delete Ad" onclick="return confirm('Are you sure you want to delete this advertisement?')">
                      <i class="fa-solid fa-trash-can"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="fa-solid fa-rectangle-ad fs-2 mb-3 d-block"></i>
                No advertisements configured. Click "Create Ad Banner" to build one.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
