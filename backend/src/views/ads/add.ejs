<%- include('../partials/header', { title: 'Create Ad - Dev Darshan Live' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <!-- Content Header -->
  <div class="content-header">
    <div class="content-title">
      <h2>Create Advertisement Banner</h2>
      <p>Upload a promotional banner image, set target redirect links, and configure popup schedules.</p>
    </div>
    <div>
      <a href="/admin/ads" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-2"></i>Back to Ads
      </a>
    </div>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Form -->
  <div class="row">
    <div class="col-lg-8">
      <form action="/admin/ads/add" method="POST" enctype="multipart/form-data" class="form-dark">
        <div class="mb-4">
          <label for="title" class="form-label">Ad Campaign Title</label>
          <input type="text" class="form-control" id="title" name="title" placeholder="e.g. Pooja Thali Offer - Shop Now" required>
        </div>

        <div class="mb-4">
          <label for="image" class="form-label">Ad Banner Image</label>
          <input type="file" class="form-control" id="image" name="image" accept="image/*" required>
          <div class="form-text text-muted">Recommended size: 600x400px. Allowed formats: PNG, JPG, JPEG, WEBP.</div>
        </div>

        <div class="mb-4">
          <label for="redirect_url" class="form-label">Redirect Target URL</label>
          <input type="url" class="form-control" id="redirect_url" name="redirect_url" placeholder="e.g. https://yourstore.com/offers">
        </div>

        <div class="row mb-4">
          <div class="col-md-6">
            <label for="display_after_minutes" class="form-label">Display After X Minutes (Time Interval)</label>
            <input type="number" min="1" class="form-control" id="display_after_minutes" name="display_after_minutes" value="5" required>
          </div>
          <div class="col-md-6">
            <label for="display_after_videos" class="form-label">Display After X Videos (View Interval)</label>
            <input type="number" min="1" class="form-control" id="display_after_videos" name="display_after_videos" value="2" required>
          </div>
        </div>

        <div class="mb-4">
          <label for="status" class="form-label">Campaign Status</label>
          <select class="form-select" id="status" name="status">
            <option value="1">Active / Enabled</option>
            <option value="0">Inactive / Disabled</option>
          </select>
        </div>

        <button type="submit" class="btn btn-gold-admin">
          <i class="fa-solid fa-cloud-arrow-up me-2"></i>Create Ad Campaign
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
