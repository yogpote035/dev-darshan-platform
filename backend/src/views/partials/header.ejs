        .sidebar-menu a {
          padding: 11px 14px;
        }
        .dashboard-card,
        .form-dark {
          padding: 14px;
        }
        .table-dark-custom table,
        .dashboard-card .table-responsive table {
          min-width: 600px;
        }
        .table-dark-custom table.users-table {
          min-width: 1380px;
        }
        .pagination-custom {
          flex-wrap: wrap;
          gap: 4px;
        }
      }
    </style>
    <script>
      (function () {
        const savedTheme = localStorage.getItem("admin-theme");
        const preferredTheme = window.matchMedia(
          "(prefers-color-scheme: light)",
        ).matches
          ? "light"
          : "dark";
        const theme =
          savedTheme === "light"
            ? "light"
            : savedTheme === "dark"
              ? "dark"
              : preferredTheme;
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body></body>
</html>
