<%- include('../partials/header', { title: 'Referral Commissions - Dev Darshan Live' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <!-- Content Header -->
  <div class="content-header">
    <div class="content-title">
      <h2>Referral Commissions Log</h2>
      <p>Monitor all commission earnings generated by users referring new subscriptions.</p>
    </div>
  </div>

  <!-- Commissions Table -->
  <div class="table-dark-custom">
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle m-0">
        <thead>
          <tr>
            <th>Referrer (Earned)</th>
            <th>Referred User (New Sign-up)</th>
            <th>Order ID</th>
            <th>Paid Amount</th>
            <th>Commission %</th>
            <th>Earned Amount</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (commissions && commissions.length > 0) { %>
            <% commissions.forEach(comm => { %>
              <tr>
                <td>
                  <% if (comm.Referrer) { %>
                    <span class="fw-semibold"><%= comm.Referrer.full_name %></span> <br/>
                    <small class="referrer-phone"><%= comm.Referrer.phone %></small>
                  <% } else { %>
                    <span class="text-danger">Unknown (ID: <%= comm.referrer_id %>)</span>
                  <% } %>
                </td>
                <td>
                  <% if (comm.ReferredUser) { %>
                    <span class="fw-semibold"><%= comm.ReferredUser.full_name %></span> <br/>
                    <small class="referrer-phone"><%= comm.ReferredUser.phone %></small>
                  <% } else { %>
                    <span class="text-muted">Deleted User</span>
                  <% } %>
                </td>
                <td>
                  <% if (comm.Payment) { %>
                    <code><%= comm.Payment.razorpay_order_id || 'N/A' %></code> <br/>
                    <span class="badge bg-success" style="font-size: 10px;"><%= comm.Payment.payment_status.toUpperCase() %></span>
                  <% } else { %>
                    <span class="text-muted">N/A</span>
                  <% } %>
                </td>
                <td>₹<%= comm.Payment ? parseFloat(comm.Payment.amount).toFixed(2) : '0.00' %></td>
                <td><%= parseFloat(comm.commission_percentage).toFixed(2) %>%</td>
                <td>
                  <span class="text-success fw-bold">₹<%= parseFloat(comm.amount).toFixed(2) %></span>
                </td>
                <td>
                  <% const date = new Date(comm.created_at); %>
                  <span class="commission-date"><%= date.toLocaleDateString('en-IN') %></span>
                  <small class="commission-time"><%= date.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></small>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <i class="fa-solid fa-receipt fs-2 mb-3 d-block"></i>
                No referral commissions logged yet.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
