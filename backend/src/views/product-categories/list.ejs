<%- include('../partials/header', { title: 'Product Categories - Dev Darshan Live' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <div class="content-header">
    <div class="content-title">
      <h2>Product Categories</h2>
      <p>Manage product groups for your devotional catalog and storefront.</p>
    </div>
    <div>
      <a href="/admin/product-categories/add" class="btn btn-gold-admin">
        <i class="fa-solid fa-plus me-2"></i>Add Product Category
      </a>
    </div>
  </div>

  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="table-dark-custom">
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle m-0">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Description</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
              <tr>
                <td>
                  <% if (category.image) { %>
                    <img src="<%= category.image %>" alt="<%= category.name %>" class="rounded border border-secondary" style="width: 60px; height: 40px; object-fit: cover;">
                  <% } else { %>
                    <div class="bg-secondary rounded border border-secondary d-flex align-items-center justify-content-center text-muted" style="width: 60px; height: 40px; font-size: 0.8rem;">No Image</div>
                  <% } %>
                </td>
                <td class="fw-semibold"><%= category.name %></td>
                <td class="text-muted"><%= category.description || 'No description' %></td>
                <td>
                  <a href="/admin/product-categories/<%= category.id %>/toggle" class="text-decoration-none">
                    <span class="badge-status <%= category.active ? 'active' : 'inactive' %>">
                      <%= category.active ? 'ACTIVE' : 'INACTIVE' %>
                    </span>
                  </a>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex">
                    <a href="/admin/product-categories/<%= category.id %>/edit" class="btn-action btn-edit" title="Edit Category">
                      <i class="fa-solid fa-pen-to-square text-warning"></i>
                    </a>
                    <a href="/admin/product-categories/<%= category.id %>/delete" class="btn-action btn-delete" title="Delete Category" onclick="return confirm('Are you sure you want to delete this category?')">
                      <i class="fa-solid fa-trash-can"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-5 text-muted">
                <i class="fa-solid fa-folder-open fs-2 mb-3 d-block"></i>
                No product categories found. Click "Add Product Category" to create one.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
