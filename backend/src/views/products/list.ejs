<%- include('../partials/header', { title: 'Products - Dev Darshan Live' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <div class="content-header">
    <div class="content-title">
      <h2>Product Management</h2>
      <p>Manage devotional product store inventory, offers, pricing and subscriptions.</p>
    </div>
    <div>
      <a href="/admin/products/add" class="btn btn-gold-admin">
        <i class="fa-solid fa-plus me-2"></i>Add Product
      </a>
    </div>
  </div>

  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="table-dark-custom">
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle m-0">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Active</th>
            <th>₹1 Offer</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length > 0) { %>
            <% products.forEach(product => { %>
              <tr>
                <td>
                  <% if (product.image) { %>
                    <img src="<%= product.image %>" alt="<%= product.name %>" class="rounded border border-secondary" style="width: 60px; height: 40px; object-fit: cover;">
                  <% } else { %>
                    <div class="bg-secondary rounded border border-secondary d-flex align-items-center justify-content-center text-muted" style="width: 60px; height: 40px; font-size: 0.8rem;">No Image</div>
                  <% } %>
                </td>
                <td>
                  <div class="fw-semibold"><%= product.name %></div>
                  <small class="text-muted"><%= product.brand || 'No brand' %></small>
                </td>
                <td>₹<%= Number(product.price || 0).toFixed(2) %></td>
                <td><%= product.stock || 0 %></td>
                <td>
                  <a href="/admin/products/<%= product.id %>/toggle" class="text-decoration-none">
                    <span class="badge-status <%= product.active ? 'active' : 'inactive' %>">
                      <%= product.active ? 'ACTIVE' : 'INACTIVE' %>
                    </span>
                  </a>
                </td>
                <td>
                  <span class="badge-status <%= product.allow_one_rupee_offer ? 'active' : 'inactive' %>">
                    <%= product.allow_one_rupee_offer ? 'ENABLED' : 'DISABLED' %>
                  </span>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex">
                    <a href="/admin/products/<%= product.id %>/edit" class="btn-action btn-edit" title="Edit Product">
                      <i class="fa-solid fa-pen-to-square text-warning"></i>
                    </a>
                    <a href="/admin/products/<%= product.id %>/delete" class="btn-action btn-delete" title="Delete Product" onclick="return confirm('Are you sure you want to delete this product?')">
                      <i class="fa-solid fa-trash-can"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 empty-state-message">
                <i class="fa-solid fa-store fs-2 mb-3 d-block"></i>
                No products found yet.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
