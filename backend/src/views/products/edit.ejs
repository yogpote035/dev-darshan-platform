<%- include('../partials/header', { title: 'Edit Product - Dev Darshan Live' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <div class="content-header">
    <div class="content-title">
      <h2>Edit Product</h2>
      <p>Update product details, pricing, stock and offer configuration.</p>
    </div>
    <div>
      <a href="/admin/products" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-2"></i>Back to Products
      </a>
    </div>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="row">
    <div class="col-lg-10">
      <form action="/admin/products/<%= product.id %>/edit" method="POST" enctype="multipart/form-data" class="form-dark">
        <div class="row g-4">
          <div class="col-md-6">
            <label for="name" class="form-label">Product Name</label>
            <input type="text" class="form-control" id="name" name="name" value="<%= product.name %>" minlength="2" maxlength="255" required>
          </div>
          <div class="col-md-6">
            <label for="slug" class="form-label">Slug</label>
            <input type="text" class="form-control" id="slug" name="slug" value="<%= product.slug || '' %>" maxlength="255" pattern="[a-z0-9]+(-[a-z0-9]+)*">
          </div>
          <div class="col-md-6">
            <label for="brand" class="form-label">Brand</label>
            <input type="text" class="form-control" id="brand" name="brand" value="<%= product.brand || '' %>" maxlength="150">
          </div>
          <div class="col-md-6">
            <label for="sku" class="form-label">SKU</label>
            <input type="text" class="form-control" id="sku" name="sku" value="<%= product.sku || '' %>" maxlength="100" pattern="[A-Za-z0-9_-]+">
          </div>
          <div class="col-md-6">
            <label for="price" class="form-label">Price</label>
            <input type="number" step="0.01" min="0" max="99999999.99" class="form-control" id="price" name="price" value="<%= Number(product.price || 0).toFixed(2) %>" required>
          </div>
          <div class="col-md-6">
            <label for="stock" class="form-label">Stock</label>
            <input type="number" min="0" max="2147483647" step="1" class="form-control" id="stock" name="stock" value="<%= product.stock || 0 %>" required>
          </div>
          <div class="col-md-6">
            <label for="category_id" class="form-label">Category</label>
            <select class="form-select" id="category_id" name="category_id">
              <option value="">Select a category</option>
              <% if (categories && categories.length) { %>
                <% categories.forEach(category => { %>
                  <option value="<%= category.id %>" <%= Number(product.category_id) === Number(category.id) ? 'selected' : '' %>><%= category.name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="col-md-6">
            <label for="image" class="form-label">Product Image</label>
            <input type="file" class="form-control" id="image" name="image" accept="image/*">
          </div>
          <div class="col-12">
            <label for="short_description" class="form-label">Short Description</label>
            <textarea class="form-control" id="short_description" name="short_description" rows="3" maxlength="500"><%= product.short_description || '' %></textarea>
          </div>
          <div class="col-12">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" id="description" name="description" rows="5" maxlength="5000"><%= product.description || '' %></textarea>
          </div>
          <div class="col-md-3">
            <label for="featured" class="form-label">Featured</label>
            <select class="form-select" id="featured" name="featured">
              <option value="0" <%= product.featured ? '' : 'selected' %>>No</option>
              <option value="1" <%= product.featured ? 'selected' : '' %>>Yes</option>
            </select>
          </div>
          <div class="col-md-3">
            <label for="active" class="form-label">Active</label>
            <select class="form-select" id="active" name="active">
              <option value="1" <%= product.active ? 'selected' : '' %>>Active</option>
              <option value="0" <%= product.active ? '' : 'selected' %>>Inactive</option>
            </select>
          </div>
          <div class="col-md-3">
            <label for="allow_one_rupee_offer" class="form-label">Enable ₹1 Offer</label>
            <select class="form-select" id="allow_one_rupee_offer" name="allow_one_rupee_offer">
              <option value="0" <%= product.allow_one_rupee_offer ? '' : 'selected' %>>No</option>
              <option value="1" <%= product.allow_one_rupee_offer ? 'selected' : '' %>>Yes</option>
            </select>
          </div>
          <div class="col-md-3">
            <label for="subscription_enabled" class="form-label">Subscription Enabled</label>
            <select class="form-select" id="subscription_enabled" name="subscription_enabled">
              <option value="0" <%= product.subscription_enabled ? '' : 'selected' %>>No</option>
              <option value="1" <%= product.subscription_enabled ? 'selected' : '' %>>Yes</option>
            </select>
          </div>
          <div class="col-md-4">
            <label for="one_rupee_price" class="form-label">₹1 Offer Price</label>
            <input type="number" step="0.01" min="0.01" class="form-control" id="one_rupee_price" name="one_rupee_price" value="<%= Number(product.one_rupee_price || 1).toFixed(2) %>">
          </div>
          <div class="col-md-4">
            <label for="subscription_trial_days" class="form-label">Trial Days</label>
            <input type="number" min="0" max="3650" step="1" class="form-control" id="subscription_trial_days" name="subscription_trial_days" value="<%= product.subscription_trial_days || 7 %>">
          </div>
          <div class="col-md-4">
            <label for="subscription_plan_id" class="form-label">Select Offer Plan</label>
            <select class="form-select" id="subscription_plan_id" name="subscription_plan_id">
              <option value="">Select an existing plan</option>
              <% if (plans && plans.length) { %>
                <% plans.forEach(plan => { %>
                  <option value="<%= plan.id %>" <%= String(product.subscription_plan_id) === String(plan.id) ? 'selected' : '' %>>
                    <%= plan.plan_name %><% if (Number(plan.price || 0) > 0) { %> — ₹<%= Number(plan.price).toFixed(2) %><% } %>
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="col-md-8">
            <label for="razorpay_plan_id" class="form-label">Razorpay Product Plan ID</label>
            <input type="text" class="form-control" id="razorpay_plan_id" name="razorpay_plan_id" value="<%= product.razorpay_plan_id || '' %>" maxlength="255" pattern="plan_[A-Za-z0-9]+" placeholder="Generated once from the recurring monthly amount when blank">
          </div>
        </div>

        <div class="mt-4">
          <button type="submit" class="btn btn-gold-admin">
            <i class="fa-solid fa-save me-2"></i>Update Product
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
