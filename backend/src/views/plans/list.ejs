<%- include('../partials/header', { title: 'Subscription Plans - Dev Darshan Live' }) %>
<%- include('../partials/sidebar') %>

<div class="main-content">
  <!-- Content Header -->
  <div class="content-header">
    <div class="content-title">
      <h2>Subscription Plans</h2>
      <p>Configure pricing plans, duration, and descriptions for premium users.</p>
    </div>
    <div>
      <a href="/admin/plans/add" class="btn btn-gold-admin">
        <i class="fa-solid fa-plus me-2"></i>Create Plan
      </a>
    </div>
  </div>

  <!-- Alerts -->
  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Plans Table -->
  <div class="table-dark-custom">
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle m-0">
        <thead>
          <tr>
            <th>Plan Name</th>
            <th>Price</th>
            <th>Duration (Days)</th>
            <th>Description</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (plans && plans.length > 0) { %>
            <% plans.forEach(plan => { %>
              <tr>
                <td class="fw-semibold"><%= plan.plan_name %></td>
                <td>
                  <% if (parseFloat(plan.price) === 0) { %>
                    <span class="text-success fw-bold">FREE</span>
                  <% } else { %>
                    ₹<%= parseFloat(plan.price).toFixed(2) %>
                  <% } %>
                </td>
                <td><%= plan.duration_days %> Days</td>
                <td>
                  <small class="plan-description"><%= plan.description || 'No description provided.' %></small>
                </td>
                <td>
                  <a href="/admin/plans/<%= plan.id %>/toggle" class="text-decoration-none">
                    <span class="badge-status <%= plan.status === 1 ? 'active' : 'inactive' %>">
                      <%= plan.status === 1 ? 'ACTIVE' : 'INACTIVE' %>
                    </span>
                  </a>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex">
                    <a href="/admin/plans/<%= plan.id %>/edit" class="btn-action btn-edit" title="Edit Plan">
                      <i class="fa-solid fa-pen-to-square text-warning"></i>
                    </a>
                    <% if (plan.plan_name.toLowerCase() !== 'free') { %>
                      <a href="/admin/plans/<%= plan.id %>/delete" class="btn-action btn-delete" title="Delete Plan" onclick="return confirm('Are you sure you want to delete this plan?')">
                        <i class="fa-solid fa-trash-can"></i>
                      </a>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="fa-solid fa-receipt fs-2 mb-3 d-block"></i>
                No subscription plans found. Click "Create Plan" to make one.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
