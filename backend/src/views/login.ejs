<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - Dev Darshan Live</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Google Fonts: Outfit -->
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    :root {
      --bg-dark: #0c0c0e;
      --bg-card: rgba(26, 26, 30, 0.7);
      --gold-primary: #d97706;
      --gold-hover: #b45309;
      --gold-gradient: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
      --text-muted: #9ca3af;
      --text-light: #f3f4f6;
    }

    body {
      font-family: 'Outfit', sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(at 10% 20%, rgba(217, 119, 6, 0.1) 0px, transparent 50%),
        radial-gradient(at 90% 80%, rgba(153, 27, 27, 0.08) 0px, transparent 50%);
      background-size: cover;
      background-attachment: fixed;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-light);
      overflow: hidden;
    }

    .login-container {
      width: 100%;
      max-width: 450px;
      padding: 15px;
    }

    .login-card {
      background: var(--bg-card);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      animation: fadeInUp 0.6s ease-out;
    }

    .logo-wrapper {
      text-align: center;
      margin-bottom: 30px;
    }

    .logo-wrapper i {
      font-size: 3rem;
      background: var(--gold-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 15px;
    }

    .logo-wrapper h1 {
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .logo-wrapper p {
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .form-control {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: var(--text-light);
      border-radius: 10px;
      padding: 12px 15px;
      font-size: 0.95rem;
      transition: all 0.3s ease;
    }

    .form-control:focus {
      background: rgba(255, 255, 255, 0.08);
      border-color: var(--gold-primary);
      box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.25);
      color: var(--text-light);
    }

    .form-label {
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .btn-gold {
      background: var(--gold-gradient);
      border: none;
      color: #fff;
      font-weight: 600;
      padding: 12px;
      border-radius: 10px;
      width: 100%;
      margin-top: 20px;
      transition: all 0.3s ease;
    }

    .btn-gold:hover {
      background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
      box-shadow: 0 5px 15px rgba(217, 119, 6, 0.3);
      transform: translateY(-2px);
    }

    .btn-gold:active {
      transform: translateY(0);
    }

    .alert-danger {
      background: rgba(220, 38, 38, 0.2);
      border: 1px solid rgba(220, 38, 38, 0.3);
      color: #fca5a5;
      font-size: 0.9rem;
      border-radius: 10px;
      margin-bottom: 20px;
      padding: 12px;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>

  <div class="login-container">
    <div class="login-card">
      <div class="logo-wrapper">
        <i class="fa-solid fa-om"></i>
        <h1>Dev Darshan Live</h1>
        <p>Admin Control Dashboard</p>
      </div>

      <div id="login-error" class="alert alert-danger d-flex align-items-center <%= error ? '' : 'd-none' %>" role="alert">
          <i class="fa-solid fa-triangle-exclamation me-2"></i>
          <div><%= error || '' %></div>
      </div>

      <form id="admin-login-form">
        <div class="mb-3">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" class="form-control" id="email" name="email" placeholder="admin@devdarshanlive.com" required>
        </div>
        <div class="mb-4">
          <label for="password" class="form-label">Password</label>
          <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-gold">
          <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
        </button>
      </form>
    </div>
  </div>

  <!-- Bootstrap Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const tokenKey = 'dev_darshan_admin_token';
    const sendAdminToken = (worker, type, token) => new Promise((resolve, reject) => {
      const channel = new MessageChannel();
      channel.port1.onmessage = (event) => event.data?.success ? resolve() : reject(new Error('Unable to save admin login.'));
      worker.postMessage({ type, token }, [channel.port2]);
    });
    const registerAdminWorker = async () => {
      if (!('serviceWorker' in navigator)) throw new Error('Your browser does not support secure admin authentication.');
      const registration = await navigator.serviceWorker.register('/admin-auth-sw.js', { scope: '/' });
      const worker = registration.active || registration.waiting || registration.installing;
      if (!worker) throw new Error('Unable to prepare secure admin authentication.');
      await sendAdminToken(worker, 'set-admin-token', localStorage.getItem(tokenKey));
      return registration;
    };
    document.getElementById('admin-login-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const error = document.getElementById('login-error');
      try {
        const response = await fetch('/admin/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: document.getElementById('email').value, password: document.getElementById('password').value }) });
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || 'Unable to sign in.');
        localStorage.setItem(tokenKey, data.token);
        await registerAdminWorker();
        window.location.assign('/admin/dashboard');
      } catch (requestError) {
        error.classList.remove('d-none'); error.querySelector('div').textContent = requestError.message;
      }
    });
    const loginReason = new URLSearchParams(window.location.search).get('reason');
    if (loginReason) {
      const hadStoredToken = Boolean(localStorage.getItem(tokenKey));
      localStorage.removeItem(tokenKey);
      navigator.serviceWorker?.getRegistration('/').then((registration) => {
        registration?.active?.postMessage({ type: 'clear-admin-token' });
      });
      window.history.replaceState({}, document.title, '/admin/login');
      if (loginReason === 'expired' || hadStoredToken) {
        const error = document.getElementById('login-error');
        error.classList.remove('d-none');
        error.querySelector('div').textContent = 'Your admin session has expired. Please sign in again.';
      }
    } else if (localStorage.getItem(tokenKey)) {
      registerAdminWorker().then(() => window.location.assign('/admin/dashboard')).catch(() => localStorage.removeItem(tokenKey));
    }
  </script>
</body>
</html>
